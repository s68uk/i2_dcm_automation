# i2 DCM Briefing — environment variables
# Copy this to .env on the Pi ONLY. Never commit the real .env — it's
# already excluded via .gitignore.
#
# NOTE: ANTHROPIC_API_KEY has been removed from this template. The script
# does not call any LLM API — classification is entirely rule-based
# (see keywords.json and i2_dcm_briefing.py). If a Claude API key becomes
# available in future, that would plug in as a downstream summarisation
# step reading this script's output, not a change to this .env.

SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="your_email@i2capitalmarkets.com"
SMTP_PASS="your_app_password"
BRIEFING_SENDER="your_email@i2capitalmarkets.com"
BRIEFING_RECIPIENT="your_email@i2capitalmarkets.com"
